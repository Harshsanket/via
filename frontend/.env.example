# Copy to frontend/.env for local development. Vite only exposes variables
# prefixed with VITE_. Docker builds pass these as build arguments instead.

# URL of the Via Socket.IO signaling server (required in development).
VITE_SOCKET_SERVER_URL=http://localhost:3000

# Optional: override the REST base used for ICE/TURN credentials.
# Defaults to <VITE_SOCKET_SERVER_URL origin>/api/v1.
# VITE_API_BASE_URL=http://localhost:3000/api/v1

# Optional: POST endpoint for privacy-preserving error and Web Vitals reports.
# VITE_ERROR_REPORTING_URL=https://errors.example.com/via

# How many times a broken transfer is retried before giving up (default 2).
# VITE_MAX_RECOVERY_ATTEMPTS=2
