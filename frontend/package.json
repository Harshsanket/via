{
  "name": "via-frontend",
  "private": true,
  "description": "React frontend for Via, a browser-to-browser file sharing app",
  "license": "GPL-3.0-only",
  "version": "1.0.0",
  "type": "module",
  "author": "Harsh Sanket",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harshsanket/via.git",
    "directory": "frontend"
  },
  "homepage": "https://github.com/Harshsanket/via#readme",
  "bugs": {
    "url": "https://github.com/Harshsanket/via/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:backend": "E2E_SOCKET_URL=${E2E_SOCKET_URL:-http://127.0.0.1:3000} playwright test e2e/real-backend.spec.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f web"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/vite": "^4.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.575.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "socket.io": "^4.8.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
