# Copy to .env and fill in. Never commit .env.

# The DuckDNS subdomain label, without ".duckdns.org" (e.g. via-home).
DUCKDNS_DOMAIN=your-subdomain
# The full name people open in their browser.
VIA_HOST=your-subdomain.duckdns.org
# From the top of https://www.duckdns.org once signed in.
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# This computer's fixed LAN address (reserve it in the router's DHCP settings).
# Pinned to the DuckDNS name by the ddns container.
#   ipconfig getifaddr en0
LAN_IP=192.168.1.50

# Password for the Redis container; only the api service connects to it.
#   openssl rand -hex 32
REDIS_PASSWORD=change-me

# Only used if the TURN relay is turned back on (single-container image only; see
# Dockerfile and docker/entrypoint.sh). Not needed on a single home network.
#   openssl rand -hex 32
# TURN_SECRET=
