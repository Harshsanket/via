# Docker Compose deployment secrets only. For local development, use
# backend/.env and frontend/.env (see their .env.example files).
# Copy to .env and fill in. Never commit .env.

# The DuckDNS subdomain label, without ".duckdns.org" (e.g. via-home).
DUCKDNS_DOMAIN=your-subdomain
# The full name people open in their browser.
VIA_HOST=your-subdomain.duckdns.org
# From the top of https://www.duckdns.org once signed in.
DUCKDNS_TOKEN=00000000-0000-0000-0000-000000000000

# This computer's LAN address. `./scripts/start.sh` detects and writes it
# before starting Compose, so it does not need editing by hand. Override with
# VIA_LAN_IP=192.168.1.50 ./scripts/start.sh when detection would be wrong.
LAN_IP=192.168.1.50

# Password for the Redis container; only the api service connects to it.
#   openssl rand -hex 32
REDIS_PASSWORD=change-me

# Shared secret for the LAN relay (coturn) and the credentials the api mints
# for it. Generate once and keep it in .env only.
#   openssl rand -hex 32
TURN_SECRET=change-me

# Session lifetimes in seconds. These are starting defaults; the host-only
# admin page (http://127.0.0.1:8081/config) can override them at runtime.
# The completed value is the window both peers get to see the result.
SESSION_TTL_SECONDS=600
REFRESH_SESSION_TTL_SECONDS=1800
SESSION_MAX_LIFETIME_SECONDS=86400
SESSION_EXPIRY_WARNING_SECONDS=30
COMPLETED_SESSION_TTL_SECONDS=30
