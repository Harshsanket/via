# Copy to backend/.env and fill in real values. The server refuses to boot
# without REDIS_URL. Docker Compose injects these values directly instead.

# Session store (required)
REDIS_URL=redis://127.0.0.1:6379

# Comma-separated browser origins allowed by CORS. Empty = same origin in
# production, any origin in development.
# CLIENT_ORIGIN=http://localhost:5173

# HTTP port (default 3000)
# PORT=3000
# Admin settings file (default ./data/settings.json in development).
# SETTINGS_PATH=./data/settings.json

# ---------------------------------------------------------------------------
# Session lifetimes (seconds)
# ---------------------------------------------------------------------------
# Defaults only. The host-only admin page can override them in settings.json.
# Initial lifetime granted by create-session.
# SESSION_TTL_SECONDS=600
# Lifetime granted when a peer joins or the session is refreshed.
# REFRESH_SESSION_TTL_SECONDS=1800
# Absolute cap, however often activity extends the session.
# SESSION_MAX_LIFETIME_SECONDS=86400
# How long before expiry the server pushes session:expiring. 0 disables it.
# SESSION_EXPIRY_WARNING_SECONDS=30
# Post-completion window before the session closes.
# COMPLETED_SESSION_TTL_SECONDS=30
# How long a dropped socket may recover before its session is cleaned up.
# RECOVERY_WINDOW_SECONDS=120

# ---------------------------------------------------------------------------
# Limits
# ---------------------------------------------------------------------------
# Sessions one peer may own.
# MAX_ACTIVE_SESSIONS_PER_PEER=1
# Concurrent sockets one client IP may hold.
# MAX_SOCKETS_PER_IP=20
# Largest announced file size in bytes. 0 means no server-side cap; the
# receiving browser checks its own free space.
# MAX_FILE_SIZE_BYTES=0
# Addresses allowed to report X-Real-IP (container/proxy addresses).
# TRUSTED_PROXIES=127.0.0.1/32,::1

# debug adds per-message signaling logs.
# LOG_LEVEL=info

# ---------------------------------------------------------------------------
# STUN / TURN
# ---------------------------------------------------------------------------
# Optional STUN override (default: stun:stun.l.google.com:19302)
# STUN_URLS=stun:stun.l.google.com:19302

# TURN relay(s) handed to clients by GET /api/v1/ice-servers, e.g.
#   TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp
# Shared secret for the relay's --use-auth-secret / --static-auth-secret.
# Short-lived credentials are minted from it; the secret itself never leaves
# the server. Leave both unset to run without a relay (ice-servers -> 503).
# TURN_URLS=
# TURN_SECRET=
# TURN_TTL_SECONDS=86400
# TURN_CREDENTIAL_ALGORITHM=sha1
