{
  "name": "via",
  "version": "1.1.0",
  "description": "Signaling server for VIA, a browser-to-browser file sharing app",
  "main": "dist/src/server.js",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm run build && node scripts/smoke.mjs",
    "test:integration": "NODE_ENV=test node --test test/*.test.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "webrtc",
    "file-sharing",
    "socket.io",
    "signaling-server",
    "self-hosted"
  ],
  "author": "Harsh Sanket",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Harshsanket/via.git",
    "directory": "backend"
  },
  "homepage": "https://github.com/Harshsanket/via#readme",
  "bugs": {
    "url": "https://github.com/Harshsanket/via/issues"
  },
  "type": "module",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "redis": "^6.3.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
