{
  "name": "via",
  "version": "0.1.0",
  "description": "Signaling server for VIA, a browser-to-browser file sharing app",
  "main": "dist/src/server.js",
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "npm run build && node scripts/smoke.mjs",
    "test:integration": "node --test test/*.test.mjs",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down -v",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "dev": "nodemon",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only",
  "type": "module",
  "dependencies": {
    "@types/pino-http": "^5.8.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.2.2",
    "@types/socket.io": "^3.0.1",
    "nodemon": "^3.1.11",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
